# ============================================================
# Experiment Conductor — .env.example
# Copy to .env and fill in your values.
# All keys are prefixed CONDUCTOR_ unless noted.
# ============================================================

# ── Watch paths (required) ───────────────────────────────────
# Comma-separated list of root directories to monitor.
# Sessions are discovered as:
#   <watch_path>/<subject_id>/<YYYY-MM-DDTHH-MM-SS>/
# Network UNC paths are supported on Windows (e.g. \\server\share\path).

CONDUCTOR_WATCH_PATHS=\\allen\aind\stage\chronic

# Comma-separated list of subject IDs (animal IDs) to process.
# Only directories whose name exactly matches one of these IDs will be scanned.
# Leave empty (or omit) to allow every subject directory in the watch paths.
# This list is re-read from this file on every poll cycle — add or remove IDs
# while the conductor is running and the change takes effect on the next scan.
# Example: CONDUCTOR_SUBJECT_IDS=842456,842457,842458
CONDUCTOR_SUBJECT_IDS=


# ── Experiment identity ──────────────────────────────────────
# Experiment type: delphi | pirouette | delphi_pirouette
CONDUCTOR_EXPERIMENT_TYPE=delphi

# Acquisition type string used in AIND acquisition.json
CONDUCTOR_ACQUISITION_TYPE=ChronicRecording

# AIND protocol ID
CONDUCTOR_PROTOCOL_ID=

# Rig/instrument identifier
CONDUCTOR_INSTRUMENT_ID=

# Physical experiment room
CONDUCTOR_EXPERIMENT_ROOM=

# Hostname of the Delphi acquisition computer
CONDUCTOR_DELPHI_COMPUTER_ID=

# Comma-separated surgeon names
CONDUCTOR_SURGEONS=

# Comma-separated experimenter names
CONDUCTOR_EXPERIMENTERS=

# Base path for surgery notes DOCX files.
# Subject subfolder is appended automatically:
#   <base>/<subject_id>/<subject_id>_craniotomy-implantation.docx
CONDUCTOR_SURGERY_NOTES_BASE=\\allen\aind\scratch\chronos\surgeryNotes


# ── delphi-data pipeline ─────────────────────────────────────
# Experiment name for snapshot step (see delphi-data REGISTRY)
CONDUCTOR_DELPHI_EXPERIMENT=bonhoeffer

# Harp firmware version for ingestion
CONDUCTOR_DELPHI_FIRMWARE=0.1.0

# Enable/disable the full pipeline step (build-dataset + snapshot)
CONDUCTOR_ENABLE_PIPELINE=true

# How often to run a processing cycle per session (minutes)
CONDUCTOR_PIPELINE_CADENCE_MINUTES=60

# Skip individual pipeline steps to save time
CONDUCTOR_PIPELINE_SKIP_BUILD=false
CONDUCTOR_PIPELINE_SKIP_CLIPS=true
CONDUCTOR_PIPELINE_SKIP_SNAPSHOT=false


# ── Metadata generation ──────────────────────────────────────
CONDUCTOR_ENABLE_METADATA=true


# ── Ephys noise-floor estimation ─────────────────────────────
# Set to true to estimate the RMS noise floor per channel from
# raw binary data (Open Ephys .dat or SpikeGLX .ap.bin).
CONDUCTOR_ENABLE_NOISE_FLOOR=false

# Seconds of data to use for the estimate
CONDUCTOR_NOISE_FLOOR_N_SECONDS=10.0

# Maximum number of channels to process (0 = all channels)
CONDUCTOR_NOISE_FLOOR_MAX_CHANNELS=0


# ── S3 upload ────────────────────────────────────────────────
CONDUCTOR_ENABLE_UPLOAD=true

# Target S3 bucket
CONDUCTOR_S3_BUCKET=aind-open-data

# Contact email for upload-job notifications
CONDUCTOR_CONTACT_EMAIL=

# AIND project name
CONDUCTOR_PROJECT_NAME=

# Number of chunks submitted per upload batch
CONDUCTOR_UPLOAD_BATCH_SIZE=2

# Number of most-recent chunks to skip (avoid in-progress data)
CONDUCTOR_NUM_LAST_CHUNKS_TO_IGNORE=2

# Maximum number of submission attempts per chunk before it is permanently skipped.
# Skipped chunks are recorded in the per-session .upload_history.json sidecar
# and will not be retried unless the sidecar is manually edited or deleted.
CONDUCTOR_UPLOAD_MAX_RETRIES=3

# Print upload requests without submitting (for testing)
CONDUCTOR_DRY_RUN=false

# Delete large local files after confirming S3 upload
CONDUCTOR_DELETE_AFTER_UPLOAD=false

# Comma-separated glob patterns (relative to run dir) to always keep locally
CONDUCTOR_KEEP_LOCAL_PATTERNS=behavior/delphi_dataset.csv,behavior/DelphiController/**,behavior/results/**,behavior/metadata/**


# ── Concurrency ──────────────────────────────────────────────
# Fallback worker count used only when CONDUCTOR_SUBJECT_IDS is empty
# (i.e. no subject-ID restriction is configured).
# When CONDUCTOR_SUBJECT_IDS is set the conductor automatically uses one
# worker per subject ID and this value is ignored.
CONDUCTOR_MAX_WORKERS=8

# ── Polling / error handling ─────────────────────────────────
# How often to scan for new sessions (seconds)
CONDUCTOR_POLL_INTERVAL_S=60.0

# Do not process a session until it is at least this old (minutes)
CONDUCTOR_MIN_SESSION_AGE_MINUTES=5.0

# Mark a session ERROR after this many consecutive failures
CONDUCTOR_MAX_CONSECUTIVE_ERRORS=5

# After an error, skip the session for this many minutes before retrying
CONDUCTOR_ERROR_BACKOFF_MINUTES=30.0


# ── State persistence ─────────────────────────────────────────
# Path to a JSON file for persisting session states across restarts.
# Leave blank to disable state persistence.
CONDUCTOR_STATE_FILE=conductor_state.json

# ── Pause control ─────────────────────────────────────────────
# Sentinel file whose existence pauses all upload submissions.
# Created / removed interactively by `conductor-status` (p / r keys).
# Can also be managed manually: create the file to pause, delete it to resume.
#
# Leave unset (the default) — the pause file is placed automatically in the
# same directory as CONDUCTOR_STATE_FILE, named conductor_pause.lock.
# Only set this if you need the pause file in a non-standard location.
#
# CONDUCTOR_PAUSE_FILE=/path/to/conductor_pause.lock


# ── Misc ─────────────────────────────────────────────────────
# Path relative to run dir used to count chunk directories
CONDUCTOR_CHUNK_CAMERA_FOLDER=behavior-videos/TopCamera


# ── Status window ────────────────────────────────────────────
# Automatically open conductor-status in a new terminal window on startup.
# Same as passing --with-status on the command line.
CONDUCTOR_LAUNCH_STATUS=false

# ── Logging verbosity ─────────────────────────────────────────
# 0 = INFO    (default) — phase transitions, success/failure summaries
# 1 = VERBOSE           — step details, file counts, offsets, config values
# 2 = DEBUG             — per-file ops, subprocess args, raw S3 results
CONDUCTOR_VERBOSITY=0
