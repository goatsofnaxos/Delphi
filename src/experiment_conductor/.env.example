# ── Experiment ──────────────────────────────────────────────────────────────
# Type: delphi | pirouette | delphi_pirouette
EXPERIMENT_TYPE=delphi_pirouette
# Launcher profile name (resolved in src/launcher/experiment_configs/)
EXPERIMENT_CONFIG=delphi_pirouette_experiment

# ── Paths ───────────────────────────────────────────────────────────────────
# Set EITHER server-relative mode OR direct DATA_ROOT — not both.
#
# Server-relative mode (recommended for standard workflow):
#   Data is robocopied from the acquisition computer to SERVER_ROOT.
#   data_root is computed as: SERVER_ROOT / SUBJECT_ID / SESSION_DATETIME
#   SESSION_DATETIME is auto-detected (newest timestamp dir) when left blank.
#   SERVER_ROOT corresponds to remote_transfer_root_path in the hardware schema.
SERVER_ROOT=\\allen\aind\stage\chronic
# SESSION_DATETIME: ISO format (2026-03-20T20:23:05Z) or dir format (2026-03-20T20-23-05).
# Colons and trailing Z are normalised automatically.
# Leave blank to auto-detect the newest session directory (polls up to 1 hour).
SESSION_DATETIME=
#
# Direct mode (set full session path explicitly, leave SERVER_ROOT blank):
# DATA_ROOT=\\allen\aind\stage\chronic\12345\2026-03-20T20-23-05
DATA_ROOT=
#
# Absolute path to launcher directory
LAUNCHER_DIR=C:/Users/brandon.pratt/Desktop/code/Delphi/src/launcher
# Surgery notes base directory (subject subfolder appended automatically)
SURGERY_NOTES_BASE=\\allen\aind\scratch\chronos\surgeryNotes

# ── Metadata inputs ──────────────────────────────────────────────────────────
SUBJECT_ID=
PROTOCOL_ID=DRn20231002
INSTRUMENT_ID=delphi-rig-0
EXPERIMENT_ROOM=447
DELPHI_COMPUTER_ID=
SURGEONS=
EXPERIMENTERS=

# ── delphi-data pipeline ─────────────────────────────────────────────────────
# Experiment name used by the delphi-data snapshot step
DELPHI_EXPERIMENT=bonhoeffer
DELPHI_FIRMWARE=0.1.0

# ── Cadence ──────────────────────────────────────────────────────────────────
# Option 1 (default): run every N minutes
PIPELINE_CADENCE_MINUTES=60
# Option 2 (on-the-hour): run at this minute past every hour (0-59).
# When set, PIPELINE_CADENCE_MINUTES is ignored.
# Example: SCHEDULE_MINUTE_OF_HOUR=45  →  runs at 10:45, 11:45, 12:45, …
# SCHEDULE_MINUTE_OF_HOUR=

# ── Upload ───────────────────────────────────────────────────────────────────
# Folder (relative to data_root) whose timestamp sub-dirs are counted as chunks
# when gating the upload start job. Change if your camera folder is named differently.
CHUNK_CAMERA_FOLDER=behavior-videos/TopCamera
S3_BUCKET=aind-open-data
CONTACT_EMAIL=
PROJECT_NAME=
# Chunks submitted per batch to the transfer service (keep small to avoid overloading the queue)
UPLOAD_BATCH_SIZE=2
# Set to true to print what would be submitted without actually submitting
DRY_RUN=false
# Delete large local files (behavior-videos/, ecephys/) after confirmed S3 upload
DELETE_AFTER_UPLOAD=false
# Comma-separated glob patterns to KEEP locally even if delete_after_upload=true
KEEP_LOCAL_PATTERNS=behavior/delphi_dataset.csv,behavior/DelphiController/**,behavior/results/**,metadata/**

# ── Stage enable/disable ─────────────────────────────────────────────────────
# Set to false to skip a stage entirely (can also be toggled at runtime by hotkey)
ENABLE_PIPELINE=true
ENABLE_METADATA=true
ENABLE_UPLOAD=true

# ── Pipeline sub-step toggles ─────────────────────────────────────────────────
# Fine-grained control over which steps run inside the delphi-data pipeline
PIPELINE_SKIP_BUILD=false        # skip build-dataset (dataset CSV construction)
PIPELINE_SKIP_CLIPS=true         # skip poke-clip extraction (slow, large)
PIPELINE_SKIP_SNAPSHOT=false     # skip figure/snapshot generation

# ── Hotkeys ──────────────────────────────────────────────────────────────────
HOTKEY_PIPELINE=<ctrl>+<shift>+p
HOTKEY_UPLOAD_PAUSE=<ctrl>+<shift>+u
HOTKEY_END_EXPERIMENT=<ctrl>+<shift>+e
# Runtime toggle hotkeys (leave blank to disable)
# HOTKEY_TOGGLE_PIPELINE=<ctrl>+<shift>+1
# HOTKEY_TOGGLE_METADATA=<ctrl>+<shift>+2
# HOTKEY_TOGGLE_UPLOAD=<ctrl>+<shift>+3
# Update acquisition end time in acquisition.json (prompts for HH:MM)
HOTKEY_UPDATE_END_TIME=<ctrl>+<shift>+t
# Reset and retry metadata generation on the next cycle
HOTKEY_RETRY_METADATA=<ctrl>+<shift>+r
