                        <Expression xsi:type="SubscribeSubject">
                          <Name>DelphiEvents</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Aeon.Acquisition:LogHarpDemux.bonsai">
                          <LogName>DelphiController</LogName>
                          <Heartbeats>Heartbeats</Heartbeats>
                          <ClosingDuration xsi:nil="true" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>DeluxEvents</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Aeon.Acquisition:LogHarpDemux.bonsai">
                          <LogName>DeLux</LogName>
                          <Heartbeats>Heartbeats</Heartbeats>
                          <ClosingDuration xsi:nil="true" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
