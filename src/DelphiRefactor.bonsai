                        <Expression xsi:type="GroupWorkflow">
                          <Name>HarpDelphiControllerGetMetadata</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>%YAML 1.1
---
# yaml-language-server: $schema=https://harp-tech.org/draft-02/schema/device.json
device: DelphiController
whoAmI: 1409
firmwareVersion: "1.0.0"
hardwareTargets: "1.0"
registers:
    ValveState:
        address: 32
        type: U16
        access: Event
        description: "Set the enabled/disabled state (enabled = 1) of all valves"
    ValvesSet:
        address: 33
        type: U16
        maskType: ValveMask
        access: Write
        description: "Write a 1 to any bit to enable the corresponding valve."
    ValvesClear:
        address: 34
        type: U16
        maskType: ValveMask
        access: Write
        description: "Write a 1 to any bit to disable the corresponding valve."
    ValveConfig0: &amp;valveConfig
        address: 35
        type: U8
        length: 12
        access: Write
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve0."
    ValveConfig1:
        &lt;&lt;: *valveConfig
        address: 36
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve1."
    ValveConfig2:
        &lt;&lt;: *valveConfig
        address: 37
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve2."
    ValveConfig3:
        &lt;&lt;: *valveConfig
        address: 38
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve3."
    ValveConfig4:
        &lt;&lt;: *valveConfig
        address: 39
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve4."
    ValveConfig5:
        &lt;&lt;: *valveConfig
        address: 40
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve5."
    ValveConfig6:
        &lt;&lt;: *valveConfig
        address: 41
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve6."
    ValveConfig7:
        &lt;&lt;: *valveConfig
        address: 42
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve7."
    ValveConfig8:
        &lt;&lt;: *valveConfig
        address: 43
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve8."
    ValveConfig9:
        &lt;&lt;: *valveConfig
        address: 44
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve9."
    ValveConfig10:
        &lt;&lt;: *valveConfig
        address: 45
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve10."
    ValveConfig11:
        &lt;&lt;: *valveConfig
        address: 46
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve11."
    ValveConfig12:
        &lt;&lt;: *valveConfig
        address: 47
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve12."
    ValveConfig13:
        &lt;&lt;: *valveConfig
        address: 48
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve13."
    ValveConfig14:
        &lt;&lt;: *valveConfig
        address: 49
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve14."
    ValveConfig15:
        &lt;&lt;: *valveConfig
        address: 50
        description: "the hit duty cycle (float: 0 - 1.0), hold duty cycle (float: 0 - 1.0), and hit duration in microseconds (U32) for Valve15."
    AuxGPIODir:
        address: 51
        type: U8
        maskType: AuxGPIOMask
        access: Write
        description: "Specify each auxiliary GPIO pin as an input (0) or output (1)."
    AuxGPIOState:
        address: 52
        type: U8
        maskType: AuxGPIOMask
        access: Write
        description: "Set the state (on or off) of any auxiliary GPIO pins specified as outputs."
    AuxGPIOSet:
        address: 53
        type: U8
        maskType: AuxGPIOMask
        access: Write
        description: "When writing a 1 to any bit, turn on the specified auxiliary GPIO pins specified as outputs."
    AuxGPIOClear:
        address: 54
        type: U8
        maskType: AuxGPIOMask
        access: Write
        description: "When writing a 1 to any bit, Turn off the specified auxiliary GPIO pins specified as outputs."
    AuxGPIOInputRiseEvent:
        address: 55
        type: U8
        maskType: AuxGPIOMask
        access: Event
        description: ""
    AuxGPIOInputFallEvent:
        address: 56
        type: U8
        maskType: AuxGPIOMask
        access: Event
        description: ""
    AuxGPIORisingInputs:
        address: 57
        type: U8
        maskType: AuxGPIOMask
        access: Write
        description: ""
    AuxGPIOFallingInputs:
        address: 58
        type: U8
        maskType: AuxGPIOMask
        access: Write
        description: ""
    PokePin:
        address: 59
        type: U8
        access: Write
        description: "which poke ports are active."
    PokePinInverted:
        address: 60
        type: U8
        access: Write
        description: "Which poke ports are inverted (i.e: transition from HIGH to LOW when a poke occurs)."
    PokeState:
        address: 61
        type: U8
        access: Event
        description: "The state of the poke port. An event will be triggered given a poke/ beam break that is greater than the min poke time."
    RawPokeState:
        address: 62
        type: U8
        access: Event
        description: "The raw state of the poke pin. Events will be triggered at the onset of a beam break (1) and offset (0)."
    PokeDometer:
        address: 63
        type: U32
        access: Read
        description: "number of mouse pokes per port since boot or reset."
    FSMState:
        address: 64
        type: U8
        access: Write
        description: "Enable (1) (aka reset) or Disable (0) the poke handling state machine. Note that QueuedOdorIndex must be specified first. Disabling and then enabling a previously-enabled FSM will reset it to its starting state."
    ForceFSM:
        address: 65
        type: U8
        access: Write
        description: "Force the poke handling state machine to iterate as if handling a mouse poke. PokeDometers are not incremented."
    QueuedOdorMask:
        address: 66
        type: U16
        access: Event
        description: "Queued odors (value: odor valve mask) that will be delivered to the odor port given a register poke. After odors have been dispensed, the register will be set to 0, which indicates that new odors are needed"
    OdorSetupTimeUS:
        address: 67
        type: U32
        access: Write
        description: "Time alotted (in microseconds) for the vacuum valve to close."
    MinOdorDeliveryTimeUS:
        address: 68
        type: U32
        access: Write
        description: "Minimum time alotted (in microseconds) for the odor delivery state."
    MaxOdorDeliveryTimeUS:
        address: 69
        type: U32
        access: Write
        description: "Maximum time alotted (in microseconds) for the odor delivery state."
    MinimumPokeTimeUS:
        address: 70
        type: U32
        access: Write
        description: "Minimum time (in microseconds) necessary for a mouse poke port beam to be broken before being interpretted as a poke."
    OdorDwellTimeUS:
        address: 71
        type: U32
        access: Write
        description: "Time (in microseconds) that the odor remains in the delivery state."
    Cam0PinState:
        address: 72
        type: U8
        access: Event
        description: "Event is initiated when a rising edge of the camera triggered signal (PWM) is detected. The actual value of the pin doesn't change."
    Cam0FrameRate:
        address: 73
        type: U32
        access: Write
        description: "Set the frame rate of the camera trigger/ frequency of the PWM signal."
    Cam0DutyCycle:
        address: 74
        type: Float
        access: Write
        description: "Set the duty cycle of the PWM. Default and recommend is 0.5 for producing a square wave."
    EnableCam0Trigger:
        address: 75
        type: U8
        access: Write
        description: "Enable (1) and disable (0) camera triggering/ the PWM signal."
    Cam1PinState:
        address: 76
        type: U8
        access: Event
        description: "Event is initiated when a rising edge of the camera triggered signal (PWM) is detected. The actual value of the pin doesn't change."
    Cam1FrameRate:
        address: 77
        type: U32
        access: Write
        description: "Set the frame rate of the camera trigger/ frequency of the PWM signal."
    Cam1DutyCycle:
        address: 78
        type: Float
        access: Write
        description: "Set the duty cycle of the PWM. Default and recommend is 0.5 for producing a square wave."
    EnableCam1Trigger:
        address: 79
        type: U8
        access: Write
        description: "Enable (1) and disable (0) camera triggering/ the PWM signal."
    EnableValveLeds:
        address: 80
        type: U8
        access: Write
        description: "Enable (1) and disable (0) valve LEDs."
    LatestFlowRate:
        address: 81
        type: U8
        access: Read
        description: "Latest flow rate measurement sample from ADC0-8."
    LatestRawAdcSample:
        address: 82
        type: U8
        access: Read
        description: "Latest raw bit measurement sample from ADC0-8."
    EnableAdcSampling:
        address: 83
        type: U8
        access: Write
        description: "Enable (1) and disable (0) ADC sampling."
    LeakAdcChannel:
        address: 84
        type: S8
        access: Write
        description: "Set the ADC channel for leak detection. Leak detection is off by Default (-1)."
    LeakThreshold:
        address: 85
        type: Float
        access: Write
        description: "Set the threshold for leak detection in mL/min."
    LeakState:
        address: 86
        type: U8
        access: Event
        description: "Set the state for leak detection."
    ManualFlowMeter:
        address: 87
        type: S8
        access: Write
        description: "Set which ADC channel (if any) is being used for manual flow meter calibration. Set to -1 for no manual flow meter calibration."
    NominalFlowRate:
        address: 88
        type: Float
        access: Write
        description: "Set the nominal flow rate for manual flow meter calibration in mL/min."
    FlowRateTolerance:
        address: 89
        type: Float
        access: Write
        description: "Set the tolerance for flow rate detection (e.g., +-0.1 mL/min)."
    ManualFlowMeterState:
        address: 90
        type: U8
        access: Event
        description: "Set the state for manual flow meter calibration."
    FlowMeterCalibrations:
        address: 91
        type: U8
        access: Write
        description: "Calibration for the flow meters."
    PidUpdateFrequency:
        address: 92
        type: Float
        access: Write
        description: "Set the update frequency for the PID controller."
    PidGains:
        address: 93
        type: U8
        length: 12
        access: Write
        description: "Set the PID Kp, Ki, and Kd gains for the controller."
    ProportionalValve0Adc:
        address: 94
        type: U8
        access: Write
        description: "Set the ADC channel used for the control of proportional valve 0."
    ProportionalValve0EnablePid:
        address: 95
        type: U8
        access: Write
        description: "Enable (1) or disable (0) PID control for proportional valve 0."
    ProportionalValve0DutyCycle:
        address: 96
        type: Float
        access: Write
        description: "Set the duty cycle for proportional valve 0."
    ProportionalValve0TargetFlowRate:
        address: 97
        type: Float
        access: Write
        description: "Set the target flow rate for proportional valve 0."
    ProportionalValve1Adc:
        address: 98
        type: U8
        access: Write
        description: "Set the ADC channel used for the control of proportional valve 1."
    ProportionalValve1EnablePid:
        address: 99
        type: U8
        access: Write
        description: "Enable (1) or disable (0) PID control for proportional valve 1."
    ProportionalValve1DutyCycle:
        address: 100
        type: Float
        access: Write
        description: "Set the duty cycle for proportional valve 1."
    ProportionalValve1TargetFlowRate:
        address: 101
        type: Float
        access: Write
        description: "Set the target flow rate for proportional valve 1."
    ProportionalValve2Adc:
        address: 102
        type: U8
        access: Write
        description: "Set the ADC channel used for the control of proportional valve 2."
    ProportionalValve2EnablePid:
        address: 103
        type: U8
        access: Write
        description: "Enable (1) or disable (0) PID control for proportional valve 2."
    ProportionalValve2DutyCycle:
        address: 104
        type: Float
        access: Write
        description: "Set the duty cycle for proportional valve 2."
    ProportionalValve2TargetFlowRate:
        address: 105
        type: Float
        access: Write
        description: "Set the target flow rate for proportional valve 2."
    FreezePidUpdates:
        address: 106
        type: U8
        access: Write
        description: "Enable to freeze PID updates when the final valve is energized."
groupMasks:
    ValveMask:
        description: "Valve that can be configured/enabled/disabled"
        values:
            Valve0: 0x0
            Valve1: 0x1
            Valve2: 0x2
            Valve3: 0x3
            Valve4: 0x4
            Valve5: 0x5
            Valve6: 0x6
            Valve7: 0x7
            Valve8: 0x8
            Valve9: 0x9
            Valve10: 0xA
            Valve11: 0xB
            Valve12: 0xC
            Valve13: 0xD
            Valve14: 0xE
            Valve15: 0xF
            AllValves: 0xFFFF
    AuxGPIOMask:
        description: "Auxiliary GPIO index."
        values:
            AuxGPIO0: 0x01
            AuxGPIO1: 0x02
            AuxGPIO2: 0x04
            AuxGPIO3: 0x08
            AuxGPIO4: 0x10
            AuxGPIO5: 0x20
            AuxGPIO6: 0x40
            AuxGPIO7: 0x80</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="io:WriteAllText">
                            <io:Path>C:\Users\svc_aind_chronic\Documents\data\test_data\local/841322/2026-03-19T18-54-37\2026-08-17T21-08-49\behavior\DelphiController\device.yml</io:Path>
                            <io:Overwrite>false</io:Overwrite>
                            <io:Append>false</io:Append>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>DeLuxPath</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>PathPrefix</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>DeLux</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>device.yml</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Zip" />
                              </Expression>
                              <Expression xsi:type="Format">
                                <Format>{0}\{1}\{2}</Format>
                                <Selector>Item1,Item2,Item3</Selector>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="5" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="5" Label="Source2" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="4" To="5" Label="Source3" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="Path" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>HarpDeLuxGetMetadata</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>%YAML 1.1
---
# yaml-language-server: $schema=https://harp-tech.org/draft-02/schema/device.json
device: deLuxDriver
whoAmI: 1410
firmwareVersion: "1.0"
hardwareTargets: "1.0"

registers:
    ChannelCurrent:
        address: 32
        type: U16
        length: 3
        access: Write
        description: "LED current in mA for channels 1–3. Writes are clamped to ChannelMaxCurrent when an EEPROM is present. The per-channel registers ChannelCurrentCh1–3 (41–43) share storage with this array, so writing either path updates the same channel current."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Channel 1 current (mA)"
            Channel2:
                offset: 1
                description: "Channel 2 current (mA)"
            Channel3:
                offset: 2
                description: "Channel 3 current (mA)"

    ChannelEnable:
        address: 33
        type: U8
        access: [Read, Write]
        maskType: Channels
        description: "Enable or disable individual LED channels. Set a bit to enable the corresponding channel."

    ChannelMaxCurrent:
        address: 34
        type: U16
        length: 3
        access: Read
        description: "Maximum allowed current in mA for each channel, read from the LED EEPROM. 0 if no EEPROM is detected."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Channel 1 max current (mA)"
            Channel2:
                offset: 1
                description: "Channel 2 max current (mA)"
            Channel3:
                offset: 2
                description: "Channel 3 max current (mA)"

    ChannelVf:
        address: 35
        type: Float
        length: 3
        access: Read
        description: "LED forward voltage (V) for each channel, read from the EEPROM. 0.0 if no EEPROM is detected."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Channel 1 forward voltage (V)"
            Channel2:
                offset: 1
                description: "Channel 2 forward voltage (V)"
            Channel3:
                offset: 2
                description: "Channel 3 forward voltage (V)"

    DriverStatus:
        address: 36
        type: U8
        access: Read
        maskType: DriverStatusFlags
        description: "Combined error flags from the BD18398 ERRSTALL register."

    DriverTemperature:
        address: 37
        type: Float
        access: Read
        description: "BD18398 junction temperature in degrees Celsius, from the internal thermal ADC. Median of 9 one-shot conversions smoothed with an exponential average (~4 s settling), updated once per second; reads return the latest filtered value. Conversions are noisy while the buck converters switch, hence the filtering."

    RefreshEeproms:
        address: 38
        type: U8
        access: Write
        description: "Write any value to trigger an immediate EEPROM rescan on all channels. ChannelMaxCurrent and ChannelVf are updated with the result."

    ButtonPress:
        address: 39
        type: U8
        access: Event
        maskType: Channels
        description: "Fires on each physical button press (not release). Payload is a Channels bitmask of which channel buttons were pressed. Each press also toggles that channel's ChannelEnable bit (unless ChannelSoftwareOverride is set for that channel)."

    ChannelSoftwareOverride:
        address: 40
        type: U8
        access: [Read, Write]
        maskType: Channels
        description: "Software override bitmask. When a channel bit is set, ChannelEnable controls that channel and the physical button is ignored. When clear, the button toggles the channel."

    ChannelCurrentCh1:
        address: 41
        type: U16
        access: Write
        description: "Set channel 1 LED current (mA), clamped to ChannelMaxCurrent[0] if an EEPROM is present. Shares storage with ChannelCurrent[0] (address 32); writing either is reflected in the other."

    ChannelCurrentCh2:
        address: 42
        type: U16
        access: Write
        description: "Set channel 2 LED current (mA), clamped to ChannelMaxCurrent[1] if an EEPROM is present. Shares storage with ChannelCurrent[1] (address 32); writing either is reflected in the other."

    ChannelCurrentCh3:
        address: 43
        type: U16
        access: Write
        description: "Set channel 3 LED current (mA), clamped to ChannelMaxCurrent[2] if an EEPROM is present. Shares storage with ChannelCurrent[2] (address 32); writing either is reflected in the other."

    PwmDutyCycle:
        address: 44
        type: Float
        length: 3
        access: [Read, Write]
        minValue: 0.0
        maxValue: 1.0
        description: "Configure PWM duty cycle as a fraction (0.0-1.0) for each channel. 0.0 = channel held off; 1.0 = channel held on (no PWM). Only active when PwmEnable is set and PwmFrequency is non-zero for that channel."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Channel 1 PWM duty cycle (0.0-1.0)"
            Channel2:
                offset: 1
                description: "Channel 2 PWM duty cycle (0.0-1.0)"
            Channel3:
                offset: 2
                description: "Channel 3 PWM duty cycle (0.0-1.0)"

    PwmFrequency:
        address: 45
        type: U16
        length: 3
        access: [Read, Write]
        minValue: 0
        maxValue: 1000
        description: "Software PWM frequency (Hz) for each channel. 0 = PWM disabled for that channel (held at its enable state). PwmDutyCycle is ignored when frequency is 0."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Channel 1 PWM frequency (Hz)"
            Channel2:
                offset: 1
                description: "Channel 2 PWM frequency (Hz)"
            Channel3:
                offset: 2
                description: "Channel 3 PWM frequency (Hz)"

    PwmEnable:
        address: 46
        type: U8
        access: [Read, Write]
        maskType: Channels
        description: "Per-channel PWM enable bitmask. Set a bit to activate software PWM for that channel using PwmFrequency and PwmDutyCycle. Clear a bit to hold the channel at its normal enable state. Freq/duty settings are preserved when PWM is disabled."

    TriggerMode:
        address: 47
        type: U8
        length: 3
        access: [Read, Write]
        description: "Input mode for each trigger pin. 0=Off (ignored), 1=Gate (LED on while pin is high), 2=Pulse (LED on for TriggerPulseDuration ms on rising edge, re-triggerable), 3=Notify (Harp event on rising edge, no LED action). Modes 1-3 override ChannelSoftwareOverride and button state. A rising input edge in any non-Off mode emits TriggerEvent (49). The trigger output is a separate, always-available function configured via TriggerOutFrequency/TriggerOutDutyCycle (emits TriggerOutEvent (59)); on boards where input and output share a pin, an active output suspends that pin's input until the output is disabled."
        payloadSpec:
            Channel1:
                offset: 0
                maskType: TriggerModeConfig
                description: "Channel 1 trigger mode"
            Channel2:
                offset: 1
                maskType: TriggerModeConfig
                description: "Channel 2 trigger mode"
            Channel3:
                offset: 2
                maskType: TriggerModeConfig
                description: "Channel 3 trigger mode"

    TriggerPulseDuration:
        address: 48
        type: U16
        length: 3
        access: [Read, Write]
        description: "Pulse duration in milliseconds for each channel's Pulse trigger mode. A new rising edge while a pulse is active restarts the timer."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Channel 1 pulse duration (ms)"
            Channel2:
                offset: 1
                description: "Channel 2 pulse duration (ms)"
            Channel3:
                offset: 2
                description: "Channel 3 pulse duration (ms)"

    TriggerEvent:
        address: 49
        type: U8
        access: Event
        maskType: Channels
        description: "Fires on every trigger rising edge in any non-Off mode. Payload is a Channels bitmask indicating which channels triggered. Multiple channels may fire in the same event if edges coincide."

    Barrel3Active:
        address: 50
        type: U8
        access: Event
        description: "Fires when GPIO23 changes state. Payload is 1 on a low-to-high transition, 0 on a high-to-low transition."

    ChannelFaultStatus:
        address: 51
        type: U8
        length: 3
        access: [Event, Read]
        maskType: ChannelFaultFlags
        description: "Per-channel fault flags from BD18398 ERRST1–3. One byte per channel; an event is emitted when any bit changes. Faults are only reported while the channel is enabled (CHONx=1)."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Channel 1 fault flags"
            Channel2:
                offset: 1
                description: "Channel 2 fault flags"
            Channel3:
                offset: 2
                description: "Channel 3 fault flags"

    ProvisionLedInfo:
        address: 52
        type: U8
        length: 33
        access: Write
        visibility: private
        description: "Write to provision a custom LED EEPROM on the specified channel. Writing triggers an asynchronous EEPROM write on Core 1; read ProvisionResult (addr 53) to get the outcome. Payload layout: byte 0 = channel (1–3); bytes 1–2 = max current uint16 LE (mA); bytes 3–6 = forward voltage float32 LE (V); bytes 7–22 = part name (16 bytes, null-padded); bytes 23–32 = serial number (10 bytes, null-padded). Uses Search ROM to locate the DS28EC20 among other 1-Wire devices (e.g. a DS18B20 temperature sensor) on the same bus."

    ProvisionResult:
        address: 53
        type: U8
        access: Read
        visibility: private        
        description: "Result of the last ProvisionLedInfo write. 0 = idle (no result or reset); 1 = OK; 2 = no device found; 3 = write CRC error; 4 = scratchpad mismatch; 5 = copy failed; 6 = foreign chip (non-blank chip without dLx! header — refused to overwrite)."

    OnewireDeviceRoms:
        address: 54
        type: U8
        length: 96
        access: Read
        visibility: private        
        description: "1-Wire ROM codes found during the most recent bus scan. Layout: 3 channels × 4 device slots × 8 bytes. Each ROM is [family_code, serial×6, CRC8]. Unused slots are zeroed. DS28EC20 family = 0x43, DS2431 = 0x2D, DS18B20 = 0x28. Updated every periodic scan and on RefreshEeproms writes."

    ChannelTemperature:
        address: 55
        type: Float
        length: 3
        access: Read
        description: "DS18B20 board temperature (°C) for each channel. Reads the first DS18B20 found on each channel's 1-Wire bus using Match ROM. -300.0 if no DS18B20 is detected on that channel. Updated every periodic scan and on RefreshEeproms writes."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Channel 1 board temperature (°C)"
            Channel2:
                offset: 1
                description: "Channel 2 board temperature (°C)"
            Channel3:
                offset: 2
                description: "Channel 3 board temperature (°C)"

    CurrentSenseVos:
        address: 56
        type: Float
        access: [Read, Write]
        description: "BD18398 current sense amplifier offset voltage (V) used in the LED current formula: ILED = (VISET - Vos) / (12 x RSNS). Nominal datasheet value is 0.200 V; typical per-device variation is 0.200-0.215 V. Increasing this value raises the output current at all setpoints, with the largest effect at low currents. Persists across power cycles. Clamped to [0.100, 0.400] V on write. Default: 0.200 V."

    TriggerOutDutyCycle:
        address: 57
        type: Float
        length: 3
        access: [Read, Write]
        minValue: 0.0
        maxValue: 1.0
        description: "PWM output duty cycle as a fraction (0.0-1.0) for each trigger output pin. 0.0 = pin held low; 1.0 = pin held high (no PWM). Ignored when TriggerOutFrequency is 0."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Trigger output 1 duty cycle (0.0-1.0)"
            Channel2:
                offset: 1
                description: "Trigger output 2 duty cycle (0.0-1.0)"
            Channel3:
                offset: 2
                description: "Trigger output 3 duty cycle (0.0-1.0)"

    TriggerOutFrequency:
        address: 58
        type: U16
        length: 3
        access: [Read, Write]
        minValue: 0
        maxValue: 1000
        description: "PWM output frequency (Hz) for each trigger output pin. 0 = output disabled (pin held low). Capped at 1000 Hz. A rising edge of the generated output emits TriggerOutEvent (59). TriggerOutDutyCycle is ignored when frequency is 0."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Trigger output 1 frequency (Hz)"
            Channel2:
                offset: 1
                description: "Trigger output 2 frequency (Hz)"
            Channel3:
                offset: 2
                description: "Trigger output 3 frequency (Hz)"

    TriggerOutEvent:
        address: 59
        type: U8
        access: Event
        maskType: Channels
        description: "Fires on every rising edge of a trigger output pin (channels with TriggerOutFrequency &gt; 0). Payload is a Channels bitmask of the outputs that rose; multiple bits may be set when phase-aligned outputs rise together. Edges (and this event) reflect any TriggerOutDelay offset, so the event timestamp is the actual time the trigger was sent. Use this to log camera-trigger times on the host."

    TriggerOutDelay:
        address: 60
        type: S16
        length: 3
        access: [Read, Write]
        description: "Trigger output phase offset in microseconds relative to the shared PWM time base. Positive values delay the output edges: with TriggerOutFrequency equal to the LED PwmFrequency, a value of 1500 makes the trigger output rise 1500 µs after the LED PWM rising edge; -1200 makes it rise 1200 µs before. Wraps modulo the output period when the magnitude exceeds it. Use to compensate for cameras with slow trigger reads. Default: 0."
        payloadSpec:
            Channel1:
                offset: 0
                description: "Trigger output 1 delay (µs)"
            Channel2:
                offset: 1
                description: "Trigger output 2 delay (µs)"
            Channel3:
                offset: 2
                description: "Trigger output 3 delay (µs)"

bitMasks:
    Channels:
        description: "LED channel bitmask."
        bits:
            Channel1: 0x1
            Channel2: 0x2
            Channel3: 0x4

    DriverStatusFlags:
        description: "BD18398 ERRSTALL error flag bitmask."
        bits:
            ErrorCh1: 0x1
            ErrorCh2: 0x2
            ErrorCh3: 0x4
            UnderVoltage: 0x10
            PinUnderVoltage: 0x20
            CrcError: 0x40
            WatchdogError: 0x80

    ChannelFaultFlags:
        description: "BD18398 per-channel fault flags (ERRSTx register)."
        bits:
            ShortToGround: 0x1
            OpenCircuit: 0x2
            SwitchOverCurrent: 0x4
            LedOverCurrent: 0x8


groupMasks:
    TriggerModeConfig:
        values:
            None: 0
            Gate: 1
            Pulse: 2
            Notify: 3
        description: "Mode for each trigger pin. 0=Off/None (ignored), 1=Gate (LED on while pin is high), 2=Pulse (LED on for TriggerPulseDuration ms on rising edge, re-triggerable), 3=Notify (Harp event on rising edge, no LED action). Modes 1-3 override ChannelSoftwareOverride and button state."   
</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="io:WriteAllText">
                            <io:Path>C:\Users\svc_aind_chronic\Documents\data\test_data\local/841322/2026-03-19T18-54-37\2026-08-17T21-08-49\behavior\DeLux\device.yml</io:Path>
                            <io:Overwrite>false</io:Overwrite>
                            <io:Append>false</io:Append>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p5:GetMetadata" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>WhiteRabbitPath</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>PathPrefix</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>WhiteRabbit</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>device.yml</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Zip" />
                              </Expression>
                              <Expression xsi:type="Format">
                                <Format>{0}\{1}\{2}</Format>
                                <Selector>Item1,Item2,Item3</Selector>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="5" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="5" Label="Source2" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="4" To="5" Label="Source3" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="Path" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="io:WriteAllText">
                            <io:Path>C:\Users\svc_aind_chronic\Documents\data\test_data\local/841322/2026-03-19T18-54-37\2026-08-17T21-08-49\behavior\WhiteRabbit\device.yml</io:Path>
                            <io:Overwrite>false</io:Overwrite>
                            <io:Append>false</io:Append>
                          </Combinator>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="9" Label="Source1" />
                        <Edge From="8" To="9" Label="Source2" />
                        <Edge From="10" To="11" Label="Source1" />
                        <Edge From="11" To="13" Label="Source1" />
                        <Edge From="12" To="13" Label="Source2" />
                        <Edge From="14" To="15" Label="Source1" />
                        <Edge From="15" To="18" Label="Source1" />
                        <Edge From="16" To="17" Label="Source1" />
                        <Edge From="17" To="18" Label="Source2" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RuleSettings</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>DelphiEvents</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:SubscribeWhen" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Delay">
                      <rx:DueTime>PT5S</rx:DueTime>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
                    <Name>DelphiEvents</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\LogJson.bonsai">
                    <Heartbeats />
                    <ClosingDuration xsi:nil="true" />
                    <LogName>RuleSettings</LogName>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>HardwareSchema</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>DelphiEvents</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:SubscribeWhen" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Delay">
                      <rx:DueTime>PT5S</rx:DueTime>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
                    <Name>DelphiEvents</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\LogJson.bonsai">
                    <Heartbeats />
                    <ClosingDuration xsi:nil="true" />
                    <LogName>HardwareSettings</LogName>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="4" To="6" Label="Source1" />
                  <Edge From="5" To="6" Label="Source2" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="10" Label="Source1" />
                  <Edge From="11" To="13" Label="Source1" />
                  <Edge From="12" To="13" Label="Source2" />
                  <Edge From="13" To="14" Label="Source1" />
                  <Edge From="14" To="15" Label="Source1" />
                  <Edge From="15" To="16" Label="Source1" />
                  <Edge From="16" To="17" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="Combinator">
                <Combinator xsi:type="rx:Timer">
                  <rx:DueTime>PT10S</rx:DueTime>
                  <rx:Period>PT1H</rx:Period>
                </Combinator>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="Unit" />
