# ============================================================
# delphi-data configuration template
# ============================================================
# Copy this file to .env and fill in the values you want to
# override.  Leave a variable commented out or empty to use
# the built-in default.
#
# Priority (highest → lowest):
#   1. CLI argument   --tau 300
#   2. Shell env var  export DELPHI_TAU=300
#   3. .env file      DELPHI_TAU=300     ← this file
#   4. Code default   (shown below)
# ============================================================


# ------------------------------------------------------------
# Paths  (leave empty to require on the CLI each time)
# ------------------------------------------------------------
# WINDOWS NOTE: Use forward slashes or leave unquoted.
#   OK:  DELPHI_DATA_ROOT=C:/Users/name/Desktop/data/my_session
#   OK:  DELPHI_DATA_ROOT='C:\Users\name\Desktop\data\my_session'  (single quotes = literal)
#   BAD: DELPHI_DATA_ROOT="C:\Users\name\Desktop\data\my_session"  (double quotes expand \b, \t, etc.)

# Default run-level session directory used for all commands (--data-root).
# DELPHI_DATA_ROOT=

# Default experiment type for snapshot and the full processing pipeline.
# Must match a registered experiment name (e.g. bonhoeffer).
# DELPHI_EXPERIMENT=bonhoeffer


# ------------------------------------------------------------
# Poke-rate estimation
# ------------------------------------------------------------

# Exponential decay time constant (seconds).  Default: 600.0
# DELPHI_TAU=600.0

# Rate-estimator window length (seconds).  Default: 60.0
# DELPHI_DT=60.0

# Fractional window overlap [0, 1).  Default: 0.5
# DELPHI_OVERLAP=0.5


# ------------------------------------------------------------
# Windowed / switch-aligned analyses
# ------------------------------------------------------------

# Baseline days before each odor change.  Default: 3
# DELPHI_PRE_DAYS=3

# Post-change days included in windowed analysis.  Default: 1
# DELPHI_POST_DAYS=1

# Pokes per day extracted for the duration-comparison figure.  Default: 25
# DELPHI_N_POKES_DURATION=25


# ------------------------------------------------------------
# Camera / QC settings
# ------------------------------------------------------------

# Camera frame-rate override for QC plots (Hz).
# Leave empty for auto-detect (Harp register → AindBehaviorPirouetteRig.json
# → HardwareSettings → DELPHI_DEFAULT_CAMERA_FPS).
# DELPHI_CAMERA_FPS=

# Last-resort default camera frame rate when all auto-detect sources fail (Hz).
# Default: 60.0
# DELPHI_DEFAULT_CAMERA_FPS=60.0


# ------------------------------------------------------------
# Dataset ingestion
# ------------------------------------------------------------

# Firmware version string (e.g. 0.1.0).
# Leave empty to auto-detect from device.yml inside the session.
# DELPHI_FIRMWARE=

# Set to true to disable automatic run-directory consolidation.  Default: false
# DELPHI_NO_CONSOLIDATE=false

# Set to true to consolidate run sub-directories and move metadata files, then
# exit without building the dataset CSV (useful for Pirouette sessions that do
# not need a delphi_dataset.csv).  Overrides DELPHI_NO_CONSOLIDATE and makes
# --firmware optional.  Default: false
# DELPHI_CONSOLIDATE_ONLY=false

# When true, append new rows to an existing delphi_dataset.csv rather than
# skipping the build step.  Deduplicates on beam_break_onset.  Default: false
# DELPHI_DATASET_APPEND=false


# ------------------------------------------------------------
# Pipeline step control
# ------------------------------------------------------------
# Set any of these to true to skip that step in the full pipeline.
# Default: run all three steps (all false).

# DELPHI_SKIP_BUILD=false
# DELPHI_SKIP_CLIPS=false
# DELPHI_SKIP_SNAPSHOT=false


# ------------------------------------------------------------
# Video clip extraction
# ------------------------------------------------------------

# Parallel clip-export threads per chunk.  Default: 4
# DELPHI_WORKERS=4

# Set to true to keep PortCamera source files after clip export.  Default: false
# DELPHI_NO_DELETE=false
