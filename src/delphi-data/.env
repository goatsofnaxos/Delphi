# ============================================================
# delphi-data configuration
# ============================================================
# Priority (highest -> lowest):
#   1. CLI argument   --tau 300
#   2. Shell env var  export DELPHI_TAU=300
#   3. .env file      DELPHI_TAU=300     <- this file
#   4. Code default
# ============================================================


# ------------------------------------------------------------
# Paths  (leave empty to require on the CLI each time)
# ------------------------------------------------------------
DELPHI_DATA_ROOT=C:/Users/brandon.pratt/Desktop/data/test_data/842456/2026-03-20T20-23-05_test/2026-03-20T20-23-37
DELPHI_EXPERIMENT=bonhoeffer


# ------------------------------------------------------------
# Poke-rate estimation
# ------------------------------------------------------------

DELPHI_TAU=600.0
DELPHI_DT=60.0
DELPHI_OVERLAP=0.5


# ------------------------------------------------------------
# Windowed / switch-aligned analyses
# ------------------------------------------------------------

DELPHI_PRE_DAYS=3
DELPHI_POST_DAYS=1
DELPHI_N_POKES_DURATION=25


# ------------------------------------------------------------
# Camera / QC settings
# ------------------------------------------------------------

# Leave empty for auto-detect (Harp register -> AindBehaviorPirouetteRig.json
# -> HardwareSettings -> DELPHI_DEFAULT_CAMERA_FPS).
DELPHI_CAMERA_FPS=100.0
DELPHI_DEFAULT_CAMERA_FPS=60.0


# ------------------------------------------------------------
# Dataset ingestion
# ------------------------------------------------------------

# Leave empty to auto-detect from device.yml inside the session.
DELPHI_FIRMWARE="0.1.0"
DELPHI_NO_CONSOLIDATE=false
DELPHI_DATASET_APPEND=true


# ------------------------------------------------------------
# Pipeline step control  (default: run all three steps)
# ------------------------------------------------------------

DELPHI_SKIP_BUILD=false
DELPHI_SKIP_CLIPS=true
DELPHI_SKIP_SNAPSHOT=false


# ------------------------------------------------------------
# Video clip extraction
# ------------------------------------------------------------

DELPHI_WORKERS=4
DELPHI_NO_DELETE=false
